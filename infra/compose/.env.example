# Copy to infra/compose/.env (make does this automatically). Dev-only values: never reuse in prod.
COMPOSE_PROJECT_NAME=rlens

# ---- host ports (chosen to avoid 5432/8000/18000/18080 already in use on the dev machine)
RL_PG_HOST_PORT=25432
RL_KAFKA_HOST_PORT=29092
RL_API_HOST_PORT=28000
RL_WORKER_HOST_PORT=28001
RL_WEB_HOST_PORT=23000

# ---- postgres
POSTGRES_USER=rlens
POSTGRES_PASSWORD=rlens-dev-password
POSTGRES_DB=rlens

# ---- application
RL_ENV=dev
RL_LOG_LEVEL=INFO
RL_LOG_FORMAT=json
RL_CORS_ORIGINS=http://localhost:23000
RL_MAILPIT_SMTP_HOST_PORT=21025
RL_MAILPIT_UI_HOST_PORT=28025

# ---- M10 SaaS layer (docs/security/AUTH.md, docs/billing/BILLING.md)
# Leave empty in dev (a public dev key is used). Anything else: >= 32 random characters,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
RL_SECRET_KEY=
# Stripe TEST MODE only (BLOCKERS.md B2): sk_test_..., whsec_..., price_...
RL_STRIPE_SECRET_KEY=
RL_STRIPE_WEBHOOK_SECRET=
RL_STRIPE_PRICE_TEAM=
# GitHub OAuth app (BLOCKERS.md B5)
RL_GITHUB_OAUTH_CLIENT_ID=
RL_GITHUB_OAUTH_CLIENT_SECRET=

# ---- data profile (M2): object store, Airflow, pipeline
RL_MINIO_HOST_PORT=29000
RL_MINIO_CONSOLE_HOST_PORT=29001
RL_AIRFLOW_HOST_PORT=28080
# S3 credentials double as the local object store's root user/password (pgsty/silo, ADR-0009).
RL_S3_ACCESS_KEY=rlens
RL_S3_SECRET_KEY=rlens-dev-secret
RL_S3_REGION=us-east-1
RL_S3_BUCKET_DATA=releaselens-data
RL_S3_BUCKET_MLFLOW=releaselens-mlflow
# Host directory holding one sub-directory per registered dataset (rl_pipeline.datasets):
#   travistorrent-figshare-19314170-5_3_2016/travistorrent_5_3_2016.csv.gz   (primary, ADR-0017)
#   travistorrent-figshare-19314170/final-2017-01-25.csv.gz                   (secondary)
# Mounted read-only at /datasets (RL_DATASETS_DIR). Relative paths resolve against infra/compose/.
RL_DATASETS_HOST_DIR=../../data/lake/downloads
RL_DUCKDB_MEMORY_LIMIT=1GB
# Airflow (ADR-0013). Metadata DB lives on the shared postgres; dev-only secrets.
AIRFLOW_DB=airflow
AIRFLOW_JWT_SECRET=rlens-dev-jwt-secret
AIRFLOW_API_SECRET_KEY=rlens-dev-api-secret
AIRFLOW_PARALLELISM=4
# Memory limits: airflow-cli runs the whole DAG (and DuckDB) in one container.
AIRFLOW_CLI_MEM_LIMIT=2g
AIRFLOW_SCHEDULER_MEM_LIMIT=2g
AIRFLOW_API_MEM_LIMIT=768m
AIRFLOW_DAG_PROCESSOR_MEM_LIMIT=512m
AIRFLOW_TRIGGERER_MEM_LIMIT=512m
RL_MINIO_MEM_LIMIT=256m
