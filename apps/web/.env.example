# Base URL of the ReleaseLens API as seen from the *browser* (host port 28000 in local compose).
# NEXT_PUBLIC_* values are inlined at build time: changing it requires a rebuild.
NEXT_PUBLIC_RL_API_URL=http://localhost:28000

# Server-side (read at runtime by src/proxy.ts): set to 0 when the API's session cookies
# (rl_csrf / rl_access) are not visible to the web host, so /app/* is not pre-redirected to /login.
# RL_WEB_SESSION_COOKIE_CHECK=1
