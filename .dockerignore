**/.DS_Store
.git
.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.hypothesis
**/node_modules
**/.next
apps
data/raw
data/processed
data/lake
docs
demo/k6/out
mlruns
mlartifacts
**/*.parquet
**/*.duckdb
.env
**/.env
.claude

# dbt work dirs of a bare `dbt` call (rl_pipeline puts them under RL_LAKE_DIR/dbt)
data/dbt/target
data/dbt/logs
data/dbt/dbt_packages
